{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ui-kit": ["src/ui-kit"],
      "@ui-kit/*": ["src/ui-kit/*"],
      "@ui-modules": ["src/ui-modules"],
      "@ui-modules/*": ["src/ui-modules/*"],
      "@screens": ["src/screens"],
      "@screens/*": ["src/screens/*"],
      "@hooks": ["src/hooks"],
      "@hooks/*": ["src/hooks/*"],
      "@services": ["src/services"],
      "@services/*": ["src/services/*"],
      "@contexts": ["src/contexts"],
      "@contexts/*": ["src/contexts/*"],
      "@config": ["src/config"],
      "@config/*": ["src/config/*"],
      "@types": ["src/types"],
      "@types/*": ["src/types/*"],
      "@constants": ["src/constants"],
      "@constants/*": ["src/constants/*"],
      "@navigation": ["src/navigation"],
      "@navigation/*": ["src/navigation/*"],
      "@utils": ["src/utils"],
      "@utils/*": ["src/utils/*"],
      "@schemas": ["src/schemas"],
      "@schemas/*": ["src/schemas/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "react-native.config.js"],
  "exclude": ["**/node_modules", "**/Pods"]
}
